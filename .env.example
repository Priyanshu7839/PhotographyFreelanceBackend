# Copy to .env (local) or add in Render > Environment. Never commit real values.

# Existing
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
EMAIL_SENDER=reachus@midorimediacompany.com   # address that sends emails (Zoho)
PASSWORD_SENDER=         # Zoho app-specific password (Zoho Accounts > Security > App Passwords)
SMTP_USER=               # optional: Zoho login, if EMAIL_SENDER is an alias (e.g. saiteja.tadepu@midorimediacompany.com)
SMTP_HOST=smtp.zoho.com  # optional, this is the default
SMTP_PORT=465            # optional, this is the default
NODE_ENV=production

# Booking (new)
BOOKING_NOTIFY_EMAIL=midorimediacompany@gmail.com            # where new-booking alerts go
CALENDLY_URL=                                                # public event link, e.g. https://calendly.com/<you>/consultation
CALENDLY_API_TOKEN=                                          # optional: Calendly Personal Access Token, adds call time to the dashboard
ZOOM_MEETING_URL=                                            # optional: shown in the client email. Leave empty if Calendly creates Zoom links
ADMIN_BOOKINGS_URL=https://midorimediacompany.com/dashboard/bookings
BOOKING_SUBMIT_LIMIT=8                                       # booking requests per IP per hour
TRUST_PROXY_HOPS=1                                           # Render sits behind 1 proxy
