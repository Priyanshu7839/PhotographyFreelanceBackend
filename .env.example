# Copy to .env (local) or add in Render > Environment. Never commit real secret values.
# Non-secret values below are the current Midori accounts (Oct 2026).

# Storage: Cloudflare R2, account ef23b5877687a564e3f9748cd064b88c (midorimediaglobal)
R2_ENDPOINT=https://ef23b5877687a564e3f9748cd064b88c.r2.cloudflarestorage.com
R2_BUCKET=portfoliofiles
R2_ACCESS_KEY_ID=        # secret: from the R2 API token
R2_SECRET_ACCESS_KEY=    # secret: from the R2 API token
# Photos are served through signed URLs, so no public bucket URL / custom domain is needed.

# Database: Supabase project "midoribackend" (rwlbaavygigunegjoskt, us-west-2)
SUPABASE_URL=https://rwlbaavygigunegjoskt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # secret: service_role (legacy) or sb_secret_… key. Backend only.
# The backend talks to Supabase through the API key only: no anon key or DATABASE_URL is needed.

# Login tokens
JWT_SECRET=              # secret: long random string, e.g. `openssl rand -hex 32`

# Email. Render's free plan blocks SMTP, so set RESEND_API_KEY there; SMTP (Zoho) is used otherwise.
EMAIL_SENDER=reachus@midorimediacompany.com
RESEND_API_KEY=          # secret: resend.com API key (domain midorimediacompany.com verified in Resend)
PASSWORD_SENDER=         # secret: Zoho app-specific password (only for SMTP)
SMTP_USER=               # optional: Zoho login when EMAIL_SENDER is an alias (saiteja.tadepu@midorimediacompany.com)
SMTP_HOST=smtp.zoho.com  # optional, this is the default
SMTP_PORT=465            # optional, this is the default
NODE_ENV=production

# Booking
BOOKING_NOTIFY_EMAIL=reachus@midorimediacompany.com          # where new-booking alerts go
CALENDLY_URL=                                                # public event link, e.g. https://calendly.com/<you>/consultation
CALENDLY_API_TOKEN=                                          # optional: Calendly Personal Access Token, adds call time to the dashboard
ZOOM_MEETING_URL=                                            # optional: shown in the client email. Leave empty if Calendly creates Zoom links
ADMIN_BOOKINGS_URL=https://midorimediacompany.com/dashboard/bookings
BOOKING_SUBMIT_LIMIT=8                                       # booking requests per IP per hour
TRUST_PROXY_HOPS=1                                           # Render sits behind 1 proxy
